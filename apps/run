#!/bin/sh -e

ESC=$(printf '\033')
GREEN="${ESC}[1;32m"
RED="${ESC}[1;31m"
YELLOW="${ESC}[1;33m"
NC="${ESC}[0m"
WSL_CUDA_CACHE="https://cache.nixos-cuda.org"
WSL_CUDA_CACHE_KEY="cache.nixos-cuda.org:74DUi4Ye579gUqzH4ziL9IyiJBlDpMRn9MBN8oNan9M="

APP_SYSTEM=${1:?missing app system}
SCRIPT_NAME=${2:?missing script name}
shift 2

case "$SCRIPT_NAME" in
    build)
        ACTION="build"
        ;;
    build-switch)
        ACTION="switch"
        ;;
    *)
        echo "${RED}Unsupported app: $SCRIPT_NAME${NC}"
        exit 1
        ;;
esac

is_nix_os() {
    [ -e /etc/NIXOS ] && return 0

    return 1
}

is_wsl() {
    [ -r /proc/sys/kernel/osrelease ] || return 1
    grep -qi microsoft /proc/sys/kernel/osrelease
}

linux_flake_target() {
    system=$(uname -m)

    case "$system" in
        x86_64)
            echo "x86_64-linux"
            ;;
        aarch64)
            echo "aarch64-linux"
            ;;
        *)
            echo "${RED}Unsupported architecture: $system${NC}" >&2
            return 1
            ;;
    esac
}

is_vm_guest() {
    [ -e /etc/mjr-vm-guest ] && return 0
    return 1
}

vm_image_format() {
    if [ -r /etc/mjr-vm-image-format ]; then
        format=$(tr -d '[:space:]' < /etc/mjr-vm-image-format)
        case "$format" in
            qcow|raw)
                echo "$format"
                return 0
                ;;
        esac
    fi

    echo "qcow"
}

nixos_flake_target() {
    if ! flake_target=$(linux_flake_target); then
        return 1
    fi

    if is_wsl; then
        if [ "$flake_target" != "x86_64-linux" ]; then
            echo "${RED}NixOS-WSL is only configured for x86_64-linux${NC}" >&2
            return 1
        fi
        echo "wsl-$flake_target"
    elif is_vm_guest; then
        echo "vm-${flake_target}-$(vm_image_format)"
    else
        echo "$flake_target"
    fi
}

run_wsl_rebuild() {
    rebuild_action=$1
    shift

    sudo /run/current-system/sw/bin/nixos-rebuild "$rebuild_action" \
        --flake ".#$flake_target" \
        --option extra-substituters "$WSL_CUDA_CACHE" \
        --option extra-trusted-public-keys "$WSL_CUDA_CACHE_KEY" \
        "$@"
}

run_linux() {
    if [ "$ACTION" = "build" ]; then
        echo "${YELLOW}Starting build...${NC}"
    else
        echo "${YELLOW}Starting...${NC}"
    fi

    if is_nix_os; then
        if ! flake_target=$(nixos_flake_target); then
            exit 1
        fi
        echo "Running on a NixOS-based system"
        if is_wsl; then
            if [ "$ACTION" = "build" ]; then
                run_wsl_rebuild build "$@"
                return
            fi

            if [ "$(id -u)" -eq 0 ]; then
                echo "${RED}Run build-switch as a non-root WSL user${NC}" >&2
                exit 1
            fi

            configured_user=$(nix --extra-experimental-features 'nix-command flakes' \
                eval --raw ".#nixosConfigurations.$flake_target.config.wsl.defaultUser")
            current_user=$(id -un)

            if [ "$configured_user" != "$current_user" ]; then
                wsl_distro=${WSL_DISTRO_NAME:-NixOS}
                echo "${YELLOW}Preparing the configuration for WSL user $configured_user...${NC}"
                run_wsl_rebuild boot "$@"
                echo "${YELLOW}Restart NixOS-WSL from PowerShell to activate the new user:${NC}"
                echo "  wsl -t \"$wsl_distro\""
                echo "  wsl -d \"$wsl_distro\" --user root exit"
                echo "  wsl -t \"$wsl_distro\""
                exit 0
            fi

            run_wsl_rebuild switch "$@"
        elif [ "$ACTION" = "build" ]; then
            /run/current-system/sw/bin/nixos-rebuild "$ACTION" --flake ".#$flake_target" "$@"
        else
            /run/current-system/sw/bin/nixos-rebuild "$ACTION" --sudo --flake ".#$flake_target" "$@"
        fi
    else
        if ! flake_target=$(linux_flake_target); then
            exit 1
        fi
        echo "Running on a Linux system (non-NixOS)"
        home-manager "$ACTION" --flake ".#$flake_target" "$@"
    fi
}

darwin_system_type() {
    system_arch="aarch64-darwin"
    hardware_data=$(system_profiler SPHardwareDataType)

    if echo "$hardware_data" | grep -q -e "Virtual" -e "Parallels" -e "VMware"; then
        echo "${YELLOW}Using VM configuration...${NC}" >&2
        echo "${system_arch}@vm"
    elif echo "$hardware_data" | grep -q "MacBook"; then
        echo "${YELLOW}Using laptop configuration...${NC}" >&2
        echo "${system_arch}@laptop"
    else
        echo "${YELLOW}Using desktop configuration...${NC}" >&2
        echo "${system_arch}@desktop"
    fi
}

run_darwin() {
    system_type=$(darwin_system_type)
    flake_system="darwinConfigurations.${system_type}.system"

    export NIXPKGS_ALLOW_UNFREE=1

    echo "${YELLOW}Starting build for ${flake_system}...${NC}"
    if [ "$ACTION" = "build" ]; then
        nix --extra-experimental-features 'nix-command flakes' --show-trace build ".#$flake_system" "$@"
    else
        nix --extra-experimental-features 'nix-command flakes' build ".#$flake_system" "$@"
        echo "${YELLOW}Switching to new generation...${NC}"
        sudo ./result/sw/bin/darwin-rebuild switch --flake ".#${system_type}" "$@"
    fi

    echo "${YELLOW}Cleaning up...${NC}"
    unlink ./result
}

case "$APP_SYSTEM" in
    *-linux)
        run_linux "$@"
        ;;
    aarch64-darwin)
        run_darwin "$@"
        ;;
    *)
        echo "${RED}Unsupported app system: $APP_SYSTEM${NC}"
        exit 1
        ;;
esac

if [ "$ACTION" = "build" ]; then
    echo "${GREEN}Build complete!${NC}"
else
    echo "${GREEN}Switch to new generation complete!${NC}"
fi
