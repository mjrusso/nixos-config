#!/usr/bin/env bash
set -euo pipefail

# Bring VM guests up to date with this host, in two phases:
#
#   nixos    `voom nixos switch` against this checkout
#   emacs    pull the guest's `~/.emacs.d` clone

usage() {
  cat <<'USAGE'
Usage: voom-update [--flake PATH] [--public-flake PATH] [--dry-run] [--nixos] [--emacs] [VM...]

Updates VM guests from this host.

With no VM names, updates every VM whose image runs this configuration. Stopped
VMs are skipped.

Phases (with no phase flag, both run, in this order):
  --nixos             Rebuild and switch onto this checkout's configuration.
  --emacs             Update the guest's ~/.emacs.d clone.

Options:
  --flake PATH        Flake to use for NixOS switches. Defaults to the current
                      directory.
  --public-flake PATH Override the flake's nixos-config input during NixOS
                      switches.
  --dry-run           List what would be done, without doing it.
  -h, --help          Show this help.

Environment:
  EMACS_REPO_URL      Emacs configuration repository to clone if missing.

Notes:
  The emacs phase skips a guest whose ~/.emacs.d has uncommitted changes, and
  reports that guest as failed. It never discards local work.
USAGE
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 1; }
}

FLAKE_ROOT="$(pwd)"
PUBLIC_FLAKE=""
EMACS_REPO_URL="${EMACS_REPO_URL:-https://github.com/mjrusso/.emacs.d}"

DRY_RUN=0
NAMES=()
DO_NIXOS=0
DO_EMACS=0

while [ $# -gt 0 ]; do
  case "$1" in
    --flake)
      [ "$#" -ge 2 ] || { echo "--flake requires a path" >&2; exit 1; }
      FLAKE_ROOT="$(cd "$2" && pwd)"
      shift
      ;;
    --public-flake)
      [ "$#" -ge 2 ] || { echo "--public-flake requires a path" >&2; exit 1; }
      PUBLIC_FLAKE="$(cd "$2" && pwd)"
      shift
      ;;
    --dry-run) DRY_RUN=1 ;;
    --nixos) DO_NIXOS=1 ;;
    --emacs) DO_EMACS=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; exit 1 ;;
    *) NAMES+=("$1") ;;
  esac
  shift
done

if [ "$DO_NIXOS" -eq 0 ] && [ "$DO_EMACS" -eq 0 ]; then
  DO_NIXOS=1
  DO_EMACS=1
fi

require_cmd voom
require_cmd jq

if [ "$DO_NIXOS" -eq 1 ] && [ ! -f "$FLAKE_ROOT/flake.nix" ]; then
  echo "No flake.nix in $FLAKE_ROOT" >&2
  exit 1
fi

phase_nixos() {
  local name="$1" info="$2" attr arch image format field
  local -a rebuild_args=(--sudo)

  # A phase runs as the left side of `||`, which disables errexit for the whole
  # function body. Every step that feeds the flake target is therefore checked
  # by hand: an unchecked failure here builds a truncated attribute (say
  # `vm-x86_64-linux-`) and hands it to `voom nixos switch`, or reports it as a
  # successful dry run.
  attr="$(jq -r '.vm.nixos.flakeRef // empty' <<<"$info" | sed 's/^.*#//')" || return 1
  if [ -z "$attr" ]; then
    arch="$(jq -r '.vm.arch' <<<"$info")" || return 1
    image="$(jq -r '.vm.image.name' <<<"$info")" || return 1
    # Image formats are reported as `qcow2`/`raw`; the flake outputs are named
    # `vm-<system>-qcow` / `vm-<system>-raw`.
    format="$(voom image inspect "$image" --output json | jq -r '.image.format')" || return 1

    # jq prints a literal `null` for a missing key, which would otherwise reach
    # the flake reference as text.
    for field in "$arch" "$image" "$format"; do
      if [ -z "$field" ] || [ "$field" = null ]; then
        echo "cannot derive a flake target for $name" \
          "(arch='$arch', image='$image', format='$format')" >&2
        return 1
      fi
    done

    attr="vm-${arch}-${format/qcow2/qcow}"
  fi

  echo "    nixos: $FLAKE_ROOT#$attr"
  if [ "$DRY_RUN" -eq 1 ]; then return 0; fi

  if [ -n "$PUBLIC_FLAKE" ]; then
    rebuild_args+=(--override-input nixos-config "$PUBLIC_FLAKE")
  fi
  voom nixos switch "$name" --flake "$FLAKE_ROOT#$attr" -- "${rebuild_args[@]}"
}

phase_emacs() {
  local name="$1"

  echo "    emacs: $EMACS_REPO_URL"
  if [ "$DRY_RUN" -eq 1 ]; then return 0; fi

  voom ssh "$name" -- env EMACS_REPO_URL="$EMACS_REPO_URL" bash -s <<'REMOTE'
set -euo pipefail

repo="$HOME/.emacs.d"

if [ ! -e "$repo" ]; then
  git clone "$EMACS_REPO_URL" "$repo"
  exit 0
fi

if [ ! -d "$repo/.git" ]; then
  echo "$repo exists but is not a git repository" >&2
  exit 1
fi

# Never discard work that only exists in the guest.
if [ -n "$(git -C "$repo" status --porcelain)" ]; then
  echo "skipping $repo: uncommitted changes" >&2
  exit 1
fi

git -C "$repo" pull --ff-only
REMOTE
}

# Ignore non-NixOS guests. `nixosSwitch` is the proxy for "runs this
# configuration", and so for guests that have `git`.
if [ ${#NAMES[@]} -eq 0 ]; then
  while read -r name; do
    [ -n "$name" ] || continue
    image="$(voom info "$name" --output json | jq -r '.vm.image.name')"
    capable="$(voom image inspect "$image" --output json | jq -r '.image.capabilities.nixosSwitch')"
    if [ "$capable" = true ]; then
      NAMES+=("$name")
    else
      echo "skipping $name: image '$image' does not run this configuration"
    fi
  done < <(voom list --output json | jq -r '.[].name')
fi

if [ ${#NAMES[@]} -eq 0 ]; then
  echo "No VMs to update"
  exit 0
fi

UPDATED=()
SKIPPED=()
FAILED=()

for name in "${NAMES[@]}"; do
  # An unknown VM name (typo) fails here rather than being reported as a
  # stopped VM and silently passing.
  if ! info="$(voom info "$name" --output json)"; then
    echo "Cannot inspect $name" >&2
    FAILED+=("$name")
    continue
  fi

  if [ "$(jq -r '.running' <<<"$info")" != true ]; then
    echo "skipping $name: not running"
    SKIPPED+=("$name")
    continue
  fi

  echo "==> $name"

  failed_phases=()
  if [ "$DO_NIXOS" -eq 1 ]; then
    phase_nixos "$name" "$info" || failed_phases+=("nixos")
  fi
  if [ "$DO_EMACS" -eq 1 ]; then
    phase_emacs "$name" || failed_phases+=("emacs")
  fi

  if [ ${#failed_phases[@]} -eq 0 ]; then
    UPDATED+=("$name")
  else
    FAILED+=("$name(${failed_phases[*]})")
  fi
done

if [ ${#UPDATED[@]} -gt 0 ]; then
  echo "updated: ${UPDATED[*]}"
fi
if [ ${#SKIPPED[@]} -gt 0 ]; then
  echo "skipped (not running): ${SKIPPED[*]}" >&2
fi
if [ ${#FAILED[@]} -gt 0 ]; then
  echo "failed: ${FAILED[*]}" >&2
  exit 1
fi

exit 0
