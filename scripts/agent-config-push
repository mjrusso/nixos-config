#!/usr/bin/env bash
set -euo pipefail

# `~/.claude` and `~/.codex` are mostly per-machine state, so this script works
# from an allowlist rather than an excludelist.
#
# IMPORTANT: This script must be idempotent (i.e., it must be safe to re-run
# multiple times).

usage() {
  cat <<'USAGE'
Usage: agent-config-push [--dry-run] [--claude] [--codex] [--no-auth]
                         [--no-config] [--voom <vm>]... [DEST...]

Copies Claude Code and Codex configuration to each DEST (anything ssh accepts)
and to each voom VM named with --voom:

  agent-config-push --voom myvm --voom myvm2 user@myhost

With no agent flag, data from all supported agents are pushed.

Pushed:
  .claude/.credentials.json     OAuth tokens, mode 0600. Unless --no-auth.
  .claude/CLAUDE.md             If present.
  .claude/statusline-command.sh If present, even with --no-config.
  .claude/settings.json         Merges the CLAUDE_KEYS keys into the
                                destination's file. Unless --no-config.
  .codex/auth.json              OAuth tokens, mode 0600. Unless --no-auth.
  .codex/AGENTS.md              If present.
  .codex/config.toml            Merges the CODEX_KEYS tables into the
                                destination's file. Unless --no-config.

Never pushed:
  skills/                       Owned by agent-skills-link.
  agents/, commands/, rules/    Managed through ~/.agents.
  hooks/
  .claude.json, and all per-machine state: sessions, history, caches,
  databases, installation ids.

Nothing is ever removed from a destination.

Options:
  --dry-run           Report what would change, without changing anything.
  --claude            Claude Code only.
  --codex             Codex only.
  --no-auth           Do not push credentials.
  --no-config         Do not merge either agent's config file (settings.json
                      for Claude Code, config.toml for Codex).
  --voom <vm>         Push to a voom VM. Repeatable, one VM per occurrence.
  -h, --help          Show this help.

Environment:
  CLAUDE_CONFIG_DIR   Claude Code directory (default: ~/.claude).
  CODEX_HOME          Codex directory (default: ~/.codex).

Notes:
  This copies live OAuth tokens; every destination gains full access to those
  accounts. Push only to machines you control and trust.

  Tokens are copied, not shared: each agent refreshes independently, and a
  refresh on one machine can invalidate another's copy. Re-run, or log in on
  the destination, if a guest reports an expired session.

  On MacOS, Claude Code keeps credentials in the Keychain, so
  .credentials.json does not exist there.
USAGE
}

log() { echo "[agent-config-push] $*"; }
warn() { echo "[agent-config-push] $*" >&2; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 1; }
}

DRY_RUN=0
WITH_AUTH=1
WITH_CONFIG=1
MERGE_CLAUDE_CONFIG=0
MERGE_CODEX_CONFIG=0
DO_CLAUDE=0
DO_CODEX=0
DESTS=()
VOOM_NAMES=()

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --claude) DO_CLAUDE=1 ;;
    --codex) DO_CODEX=1 ;;
    --no-auth) WITH_AUTH=0 ;;
    --no-config) WITH_CONFIG=0 ;;
    --voom) shift; [ $# -gt 0 ] || { usage >&2; exit 1; }; VOOM_NAMES+=("$1") ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; exit 1 ;;
    *) DESTS+=("$1") ;;
  esac
  shift
done

declare -A DEST_IS_VOOM=()
VOOM_CONFIG=""

if [ ${#VOOM_NAMES[@]} -gt 0 ]; then
  require_cmd voom

  VOOM_CONFIG="$(mktemp)"
  trap 'rm -f "$VOOM_CONFIG"' EXIT

  # -F discards ~/.ssh/config, so pull the `Host *` defaults (IdentityFile) back
  # in. This must precede every Host block: `Include` belongs to the block that
  # encloses it, so written last it would apply to the final VM alone. voom's
  # blocks still win, because ssh keeps the first value it obtains.
  if [ -f "$HOME/.ssh/config" ]; then
    printf 'Include %s\n\n' "$HOME/.ssh/config" >> "$VOOM_CONFIG"
  fi

  for vm in "${VOOM_NAMES[@]}"; do
      if ! block="$(voom ssh-config "$vm")"; then
          exit 1
      fi
      host_alias="$(awk '/^[[:space:]]*Host[[:space:]]/ { print $2; exit }' <<<"$block")"
      if [ -z "$host_alias" ]; then
          echo "No Host alias in ssh config for $vm" >&2
          exit 1
      fi
      printf '%s\n\n' "$block" >> "$VOOM_CONFIG"
      DESTS+=("$host_alias")
      DEST_IS_VOOM["$host_alias"]=1
  done
fi

if [ ${#DESTS[@]} -eq 0 ]; then
  usage >&2
  exit 1
fi

if [ "$DO_CLAUDE" -eq 0 ] && [ "$DO_CODEX" -eq 0 ]; then
  DO_CLAUDE=1
  DO_CODEX=1
fi

require_cmd rsync
require_cmd ssh

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"

if [ "$DO_CLAUDE" -eq 1 ] && [ ! -d "$CLAUDE_DIR" ]; then
  log "no Claude Code directory at $CLAUDE_DIR, skipping claude"
  DO_CLAUDE=0
fi
if [ "$DO_CODEX" -eq 1 ] && [ ! -d "$CODEX_DIR" ]; then
  log "no Codex directory at $CODEX_DIR, skipping codex"
  DO_CODEX=0
fi

if [ "$DO_CLAUDE" -eq 0 ] && [ "$DO_CODEX" -eq 0 ]; then
  echo "Nothing to push" >&2
  exit 1
fi

CLAUDE_KEYS=(
  alwaysThinkingEnabled
  attribution
  editorMode
  effortLevel
  model
  skipAutoPermissionPrompt
  skipDangerousModePermissionPrompt
  skipWorkflowUsageWarning
  statusLine
  theme
)

if [ "$WITH_CONFIG" -eq 1 ]; then
  if [ "$DO_CLAUDE" -eq 1 ]; then
      require_cmd jq
      if [ -f "$CLAUDE_DIR/settings.json" ]; then
          MERGE_CLAUDE_CONFIG=1
      else
          log "no $CLAUDE_DIR/settings.json, skipping the claude config merge"
      fi
  fi
  if [ "$DO_CODEX" -eq 1 ]; then
      require_cmd jq
      require_cmd tomlq
      if [ -f "$CODEX_DIR/config.toml" ]; then
          MERGE_CODEX_CONFIG=1
      else
          log "no $CODEX_DIR/config.toml, skipping the codex config merge"
      fi
  fi
fi

SSH_OPTS=()
RSYNC_SSH="ssh"

CLAUDE_FRAGMENT=""
if [ "$MERGE_CLAUDE_CONFIG" -eq 1 ]; then
  claude_keys_json="$(printf '%s\n' "${CLAUDE_KEYS[@]}" | jq -R . | jq -sc .)"
  CLAUDE_FRAGMENT="$(jq -c --argjson keys "$claude_keys_json" \
    'with_entries(select(.key as $k | $keys | index($k)))' \
    "$CLAUDE_DIR/settings.json")"
  if [ "$CLAUDE_FRAGMENT" = "{}" ]; then
    warn "no portable settings keys present in $CLAUDE_DIR/settings.json"
    MERGE_CLAUDE_CONFIG=0
  fi
fi

CODEX_KEYS=(
  approvals_reviewer
  features
  tui
)

CODEX_FRAGMENT=""
if [ "$MERGE_CODEX_CONFIG" -eq 1 ]; then
  codex_keys_json="$(printf '%s\n' "${CODEX_KEYS[@]}" | jq -R . | jq -sc .)"
  # model_availability_nux is a per-machine notice counter riding inside [tui].
  CODEX_FRAGMENT="$(tomlq -c --argjson keys "$codex_keys_json" \
    'with_entries(select(.key as $k | $keys | index($k)))
     | del(.tui.model_availability_nux)' \
    "$CODEX_DIR/config.toml")"
  if [ "$CODEX_FRAGMENT" = "{}" ]; then
    warn "no portable tables present in $CODEX_DIR/config.toml"
    MERGE_CODEX_CONFIG=0
  fi
fi

declare -A DEST_HAS=()
DEST_HOME=""

# --mkpath creates a missing ~/.claude or ~/.codex on a real run, but under
# --dry-run rsync reports the directory and then fails to descend into it. Skip
# the transfer instead, or a dry run against a fresh destination looks broken.
dry_run_would_create() {
  [ "$DRY_RUN" -eq 1 ] && [ "${DEST_HAS[$1]}" -eq 0 ]
}

# push_file DEST REMOTE_DIR NAME [SRC_DIR]
push_file() {
  local dest="$1" remote_dir="$2" name="$3" src_dir="${4:-}"
  local src="$src_dir/$name"
  local -a opts=(-a --mkpath)

  if [ ! -f "$src" ]; then
    log "  $remote_dir/$name: absent, skipped"
    return 0
  fi

  if dry_run_would_create "$remote_dir"; then
    log "  $remote_dir/$name: would create"
    return 0
  fi

  [ "$DRY_RUN" -eq 1 ] && opts+=(--dry-run --itemize-changes)

  # -a preserves the source mode, keeping the credential files at 0600.
  rsync "${opts[@]}" -e "$RSYNC_SSH" "$src" "$dest:$remote_dir/$name"
}

push_claude_config() {
  local dest="$1" remote merged

  remote="$(ssh "${SSH_OPTS[@]}" "$dest" -- \
    'cat .claude/settings.json 2>/dev/null || true')"
  [ -n "$remote" ] || remote='{}'

  if ! merged="$(jq --argjson frag "$CLAUDE_FRAGMENT" '. * $frag' <<<"$remote" 2>/dev/null)"; then
    warn "  .claude/settings.json: destination copy is not valid JSON, skipped"
    return 1
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "  .claude/settings.json: would merge $CLAUDE_FRAGMENT"
    return 0
  fi

  # Via a temporary file: an interrupted push must not truncate the original.
  ssh "${SSH_OPTS[@]}" "$dest" -- \
    'mkdir -p .claude && cat > .claude/settings.json.tmp && mv .claude/settings.json.tmp .claude/settings.json' \
    <<<"$merged"
  log "  .claude/settings.json: merged $(jq -c 'keys' <<<"$CLAUDE_FRAGMENT")"
}

push_codex_config() {
  local dest="$1" remote merged

  # The merge runs here, not on the destination, so only this machine needs
  # tomlq.
  remote="$(ssh "${SSH_OPTS[@]}" "$dest" -- \
    'cat .codex/config.toml 2>/dev/null || true')"

  if ! merged="$(tomlq -t --argjson frag "$CODEX_FRAGMENT" '. * $frag' \
    <<<"$remote" 2>/dev/null)"; then
    warn "  .codex/config.toml: destination copy is not valid TOML, skipped"
    return 1
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "  .codex/config.toml: would merge $(jq -c 'keys' <<<"$CODEX_FRAGMENT")"
    return 0
  fi

  ssh "${SSH_OPTS[@]}" "$dest" -- \
    'mkdir -p .codex && cat > .codex/config.toml.tmp && mv .codex/config.toml.tmp .codex/config.toml' \
    <<<"$merged"
  log "  .codex/config.toml: merged $(jq -c 'keys' <<<"$CODEX_FRAGMENT")"
}

PUSHED=()
FAILED=()

for dest in "${DESTS[@]}"; do
  echo "==> $dest"

  if [ -n "${DEST_IS_VOOM[$dest]:-}" ]; then
    SSH_OPTS=(-F "$VOOM_CONFIG")
    RSYNC_SSH="ssh -F $VOOM_CONFIG"
  else
    SSH_OPTS=()
    RSYNC_SSH="ssh"
  fi

  if ! err="$(ssh "${SSH_OPTS[@]}" "$dest" -- true 2>&1 >/dev/null)"; then
    warn "cannot reach $dest over ssh${err:+: $err}"
    FAILED+=("$dest")
    continue
  fi

  if ! probe="$(ssh "${SSH_OPTS[@]}" "$dest" -- \
    'test -d .claude && echo yes || echo no
     test -d .codex && echo yes || echo no
     printf "%s\n" "$HOME"')"; then
    warn "cannot probe $dest"
    FAILED+=("$dest")
    continue
  fi

  DEST_HAS[.claude]=0
  DEST_HAS[.codex]=0
  [ "$(sed -n 1p <<<"$probe")" = yes ] && DEST_HAS[.claude]=1 || true
  [ "$(sed -n 2p <<<"$probe")" = yes ] && DEST_HAS[.codex]=1 || true
  DEST_HOME="$(sed -n 3p <<<"$probe")"

  # The status line command is generated with an absolute path. Warn rather than
  # rewrite it: silently editing a user's command is worse than a clear warning.
  if [ "$MERGE_CLAUDE_CONFIG" -eq 1 ] && [ -n "$DEST_HOME" ] && [ "$DEST_HOME" != "$HOME" ]; then
    if grep -qF -- "$HOME/" <<<"$CLAUDE_FRAGMENT"; then
      warn "  .claude/settings.json: a pushed value embeds $HOME, but $dest uses $DEST_HOME"
      warn "  .claude/settings.json: that path will not resolve there; rewrite the command to use \$HOME"
    fi
  fi

  failed_entries=()

  if [ "$DO_CLAUDE" -eq 1 ]; then
    [ "${DEST_HAS[.claude]}" -eq 1 ] || log "  .claude: absent, will be created"

    if [ "$WITH_AUTH" -eq 1 ]; then
      if [ "$DRY_RUN" -eq 1 ]; then
        log "  .claude/.credentials.json: would push OAuth tokens"
      else
        log "  .claude/.credentials.json: pushing OAuth tokens"
      fi
      push_file "$dest" ".claude" ".credentials.json" "$CLAUDE_DIR" \
        || failed_entries+=(".claude/.credentials.json")
    fi

    push_file "$dest" ".claude" "CLAUDE.md" "$CLAUDE_DIR" \
      || failed_entries+=(".claude/CLAUDE.md")
    push_file "$dest" ".claude" "statusline-command.sh" "$CLAUDE_DIR" \
      || failed_entries+=(".claude/statusline-command.sh")

    if [ "$MERGE_CLAUDE_CONFIG" -eq 1 ]; then
      push_claude_config "$dest" || failed_entries+=(".claude/settings.json")
    fi
  fi

  if [ "$DO_CODEX" -eq 1 ]; then
    [ "${DEST_HAS[.codex]}" -eq 1 ] || log "  .codex: absent, will be created"

    if [ "$WITH_AUTH" -eq 1 ]; then
      if [ "$DRY_RUN" -eq 1 ]; then
        log "  .codex/auth.json: would push OAuth tokens"
      else
        log "  .codex/auth.json: pushing OAuth tokens"
      fi
      push_file "$dest" ".codex" "auth.json" "$CODEX_DIR" \
        || failed_entries+=(".codex/auth.json")
    fi

    push_file "$dest" ".codex" "AGENTS.md" "$CODEX_DIR" \
      || failed_entries+=(".codex/AGENTS.md")

    if [ "$MERGE_CODEX_CONFIG" -eq 1 ]; then
      push_codex_config "$dest" || failed_entries+=(".codex/config.toml")
    fi
  fi

  if [ ${#failed_entries[@]} -eq 0 ]; then
    PUSHED+=("$dest")
  else
    FAILED+=("$dest(${failed_entries[*]})")
  fi
done

if [ ${#PUSHED[@]} -gt 0 ]; then
  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry run, nothing was written; would push to: ${PUSHED[*]}"
  else
    log "pushed: ${PUSHED[*]}"
  fi
fi
if [ ${#FAILED[@]} -gt 0 ]; then
  warn "failed: ${FAILED[*]}"
  exit 1
fi

exit 0
