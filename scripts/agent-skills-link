#!/usr/bin/env bash
set -euo pipefail

# Link global agent skills into each agent's own skills directory.
#
# Skills live in `~/.agents/skills/`, installed with `npx skills add <source>
# -g`. Each agent discovers skills under its own directory (`~/.claude/skills`,
# `~/.codex/skills`).
#
# This script creates these symlinks (from `~/.agents/skills/` to the
# agent-specific directories).
#
# IMPORTANT: This script must be idempotent (i.e., it must be safe to re-run
# multiple times).

usage() {
  cat <<'USAGE'
Usage: agent-skills-link [--dry-run] [--no-prune]

Symlinks every skill in ~/.agents/skills/ into each agent's skills directory.

The script prunes narrowly: it removes a symlink only when that symlink points
into ~/.agents/skills/ and its source is no longer a skill (the source is gone,
or it no longer holds a SKILL.md). Everything else stays, including symlinks
that point elsewhere and real files and directories.

Exits non-zero if a real file or directory blocked a skill from being linked.

Options:
  --dry-run           Report what would change, without changing anything.
  --no-prune          Do not remove symlinks to sources that are no longer
                      skills.
  -h, --help          Show this help.

Environment:
  AGENTS_DIR          Canonical skills root (default: ~/.agents).
  CODEX_HOME          Codex home directory (default: ~/.codex).
USAGE
}

log() { echo "[agent-skills-link] $*"; }
warn() { echo "[agent-skills-link] $*" >&2; }

DRY_RUN=0
PRUNE=1

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --no-prune) PRUNE=0 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
  shift
done

AGENTS_DIR="${AGENTS_DIR:-$HOME/.agents}"
CANONICAL_DIR="$AGENTS_DIR/skills"

# Agent-specific global skills directories.
# See: https://github.com/vercel-labs/skills/blob/main/src/agents.ts
TARGET_DIRS=(
  "$HOME/.claude/skills"
  "${CODEX_HOME:-$HOME/.codex}/skills"
)

# A guest that has not received a push yet has no canonical directory. That is
# not an error: it only means there is nothing to link yet.
if [ ! -d "$CANONICAL_DIR" ]; then
  log "no skills directory at $CANONICAL_DIR"
  exit 0
fi

# Collect skills: any subdirectory holding a SKILL.md. This skips Syncthing's
# own metadata (`.stfolder`) and any other stray directories.
SKILLS=()
for dir in "$CANONICAL_DIR"/*/; do
  [ -d "$dir" ] || continue
  name="$(basename "$dir")"
  if [ ! -f "$dir/SKILL.md" ]; then
    warn "skipping $name: no SKILL.md"
    continue
  fi
  SKILLS+=("$name")
done

if [ ${#SKILLS[@]} -eq 0 ]; then
  log "no skills found in $CANONICAL_DIR"
  exit 0
fi

LINKED=0
RELINKED=0
PRUNED=0
BLOCKED=0

for target_dir in "${TARGET_DIRS[@]}"; do
  agent="$(basename "$(dirname "$target_dir")")"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$target_dir"
  elif [ ! -d "$target_dir" ]; then
    log "[$agent] would create $target_dir"
  fi

  for name in "${SKILLS[@]}"; do
    source_dir="$CANONICAL_DIR/$name"
    target="$target_dir/$name"

    if [ -L "$target" ]; then
      current="$(readlink "$target")"
      if [ "$current" = "$source_dir" ]; then
        continue
      fi
      if [ "$DRY_RUN" -eq 1 ]; then
        log "[$agent] would re-link $name (points at $current)"
      else
        ln -sfn "$source_dir" "$target"
        log "[$agent] re-linked $name (was pointing at $current)"
      fi
      RELINKED=$((RELINKED + 1))
    elif [ -e "$target" ]; then
      warn "[$agent] skipping $name: a real file or directory exists at $target"
      BLOCKED=$((BLOCKED + 1))
    else
      if [ "$DRY_RUN" -eq 1 ]; then
        log "[$agent] would link $name"
      else
        ln -s "$source_dir" "$target"
        log "[$agent] linked $name"
      fi
      LINKED=$((LINKED + 1))
    fi
  done

  [ "$PRUNE" -eq 1 ] || continue
  [ -d "$target_dir" ] || continue

  for entry in "$target_dir"/* "$target_dir"/.[!.]*; do
    [ -L "$entry" ] || continue
    dest="$(readlink "$entry")"
    case "$dest" in
      "$CANONICAL_DIR"/*) ;;
      *) continue ;;
    esac
    if [ -f "$dest/SKILL.md" ]; then
      continue
    fi

    if [ -e "$dest" ]; then
      reason="no longer a skill"
    else
      reason="source no longer exists"
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
      log "[$agent] would prune $(basename "$entry") ($reason)"
    else
      rm "$entry"
      log "[$agent] pruned $(basename "$entry") ($reason)"
    fi
    PRUNED=$((PRUNED + 1))
  done
done

if [ "$DRY_RUN" -eq 1 ]; then
  log "dry run: ${#SKILLS[@]} skill(s); would link $LINKED, re-link $RELINKED, prune $PRUNED"
else
  log "${#SKILLS[@]} skill(s); linked $LINKED, re-linked $RELINKED, pruned $PRUNED"
fi

if [ "$BLOCKED" -gt 0 ]; then
  warn "$BLOCKED skill(s) blocked by an existing file or directory"
  exit 1
fi

exit 0
