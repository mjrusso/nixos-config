#!/usr/bin/env bash
set -euo pipefail

# IMPORTANT: This script must be idempotent (i.e., it must be safe to re-run
# multiple times).

log() { echo "[home-bootstrap] $*"; }

log_manual_secret_setup() {
  if [ -r /run/voom/metadata.json ]; then
    cat <<'EOF'
[home-bootstrap] Guest credential setup:
[home-bootstrap]
[home-bootstrap]   This is a Voom guest. Do **not** run `gh auth login`, do **not** copy
[home-bootstrap]   a GitHub token into the guest, and do **not** forward the host's ssh-agent.
[home-bootstrap]
[home-bootstrap]   GitHub access should come from Agent Vault on the host. If this VM is not
[home-bootstrap]   attached, stop it and follow the "Attach a New VM" procedure in the
[home-bootstrap]   nixos-config README.
[home-bootstrap]
[home-bootstrap]   Previously, the recommendation was to mint a fine-grained PAT restricted
[home-bootstrap]   to the exact repos and permissions the agent needs, with a short expiry,
[home-bootstrap]   piping it in from 1Password on the host (adjusting the op:// reference
[home-bootstrap]   to match the vault and item names):
[home-bootstrap]
[home-bootstrap]       op read "op://Private/github-vm-pat-xxx/credential" \
[home-bootstrap]         | voom ssh <name> 'gh auth login --with-token'
[home-bootstrap]
[home-bootstrap]    However, the current guidance is to **not** put the secret into the guest
[home-bootstrap]    at all, and to instead allow Agent Vault to inject it at request time.

EOF
    return
  fi

  cat <<'EOF'
[home-bootstrap] Manual secret setup:
[home-bootstrap]
[home-bootstrap]   GitHub authentication and other secrets are deliberately not handled here.
[home-bootstrap]
[home-bootstrap]   Run `gh auth login` and follow the browser/device flow. Home Manager has
[home-bootstrap]   already configured `gh` as Git's credential helper for GitHub.
EOF
}

clone_if_missing() {
  local url="$1" dest="$2"
  if [ -d "$dest" ]; then
    log "$dest already exists — skipping"
    return 0
  fi
  log "cloning $url -> $dest"
  git clone "$url" "$dest"
}

warm_emacs() {
  local emacs_dir="$HOME/.emacs.d"
  if [ ! -d "$emacs_dir" ]; then
    log "$emacs_dir does not exist — skipping Emacs warm-up"
    return 0
  fi

  if ! command -v emacs >/dev/null 2>&1; then
    log "emacs is not available — skipping Emacs warm-up"
    return 0
  fi

  if ! command -v emacsclient >/dev/null 2>&1; then
    log "emacsclient is not available — skipping Emacs warm-up"
    return 0
  fi

  local server_name="home-bootstrap-$$"
  log "warming Emacs by starting temporary daemon '$server_name'"
  emacs --daemon="$server_name"

  log "stopping temporary Emacs daemon '$server_name'"
  if ! emacsclient -s "$server_name" -e '(kill-emacs)' >/dev/null; then
    log "failed to stop temporary Emacs daemon '$server_name'"
    pkill -f "emacs.*--daemon=$server_name" 2>/dev/null || true
    return 1
  fi
}

clone_if_missing "https://github.com/mjrusso/.emacs.d" "$HOME/.emacs.d"

mkdir -p "$HOME/git/github.com/mjrusso"

clone_if_missing "https://github.com/mjrusso/wingman" "$HOME/git/github.com/mjrusso/wingman"

warm_emacs

log ""
log ""

log_manual_secret_setup

log ""
log ""

log "Done"
